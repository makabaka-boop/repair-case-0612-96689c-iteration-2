{
  "name": "axle-mode-inspector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "夜间列车轴温读数区间众数巡检工具（TypeScript + React + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run test:unit && npm run build && playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
